# Alpaca (paper account is enough; free Basic market-data plan)  https://app.alpaca.markets
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# defaults; override only if you use a live account for the Trading API endpoints (clock, calendar, contracts)
APCA_API_BASE_URL=https://paper-api.alpaca.markets
APCA_DATA_URL=https://data.alpaca.markets

# FRED (optional; yields/yen history)  https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Reddit script app (optional; Arctic Shift is used when empty)  https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# SEC EDGAR requires a contact in the User-Agent
SEC_USER_AGENT=moonape you@example.com

# X posts for the Socials tab via twitterapi.io (~$0.15 per 1,000 tweets; $1 free trial)  https://twitterapi.io
TWITTERAPI_IO_KEY=
